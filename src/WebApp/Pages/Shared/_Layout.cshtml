<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Air Quality Alert System</title>
    <link rel="icon" href="@Url.Content("~/icon.svg")" type="image/svg+xml">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body id="top" class="d-flex flex-column vh-100">
<a class="skip-nav shadow border border-2 rounded border-info bg-info-subtle text-info-emphasis d-print-none" href="#main-content">Skip to main content</a>

<environment exclude="Production">
    <div class="banner-test-site">Test Site</div>
</environment>

<header role="banner">
    <nav id="main-nav" class="navbar nav-underline navbar-expand-sm text-bg-brand bg-gradient border-bottom shadow-sm mb-3 d-print-none">
        <div class="container">
            <a asp-page="/Index" title="Home">
                <img src="~/images/epd-icon.svg" alt="Georgia EPD" class="img-logo pe-2" />
            </a>
            <a class="navbar-brand nav-link me-2" asp-page="/Index" title="Home">Air Quality Alert<span class="d-sm-inline d-md-none">s</span>
                <span class="d-sm-none d-md-inline">System</span></a>
            <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav-content"
                    aria-controls="main-nav-content" aria-haspopup="menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span> <span class="align-middle menu-text">Menu</span>
            </button>

            <div id="main-nav-content" class="navbar-collapse collapse d-sm-inline-flex">
                <div class="flex-grow-1"></div>
                <ul class="navbar-nav flex-grow-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Status">Status</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RunLog">Run Log</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/MessageLog">Message<span class="d-sm-inline d-md-none">s</span>
                            <span class="d-sm-none d-md-inline">Log</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/TemplateTest">Template<span class="d-sm-inline d-md-none">s</span>
                            <span class="d-sm-none d-md-inline">Test</span></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main id="main-content" role="main" class="flex-grow-1">
    <div class="container">
        @RenderBody()
    </div>
</main>

<footer class="footer pt-3">
    <div class="bg-body-tertiary py-2 border-bottom d-print-none">
        <div class="container">
            <a href="#top" class="btn-subtle link-body-emphasis icon-link ms-n1 text-decoration-none">
                <svg class="bi" aria-hidden="true">
                    <use href="@Url.Content("~/images/app-icons.svg")#app-icon-arrow-bar-up"></use>
                </svg>
                Return to top
            </a>
        </div>
    </div>
    <div class="bg-body-secondary pt-2 pb-3">
        <div class="container">
            <small>
                Air Quality Alert Notification System
                <span class="text-body-secondary">|</span>
                &copy; @DateTime.Now.Year.ToString() State of Georgia
                <span class="d-print-none">
                    <span class="text-body-secondary">|</span>
                    <a asp-page="/Support" class="btn-subtle">Support</a>
                </span>
            </small>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", false)
<script>
    ;(function () {
        function updateTheme() {
            document.querySelector("html").setAttribute("data-bs-theme",
                window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        }

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateTheme)
        updateTheme()
    })()
</script>
</body>
</html>
